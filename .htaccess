# Front controller fallback kalau document root tidak bisa diarahkan ke public/
RewriteEngine On

# Blok akses langsung ke folder sensitif
RewriteRule ^(app|config|database|tests|uploads|vendor)(/|$) - [F,L]

# Jika sudah mengakses folder public, jangan rewrite lagi (mencegah redirect loop)
RewriteRule ^public($|/) - [L]

# Arahkan semua request ke public/
RewriteRule ^(.*)$ public/$1 [L]
